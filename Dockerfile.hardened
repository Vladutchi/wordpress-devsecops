FROM wordpress:latest

# Switch to non‑root user for security
RUN useradd -m -u 1000 -s /bin/bash wpuser && \
    chown -R wpuser:wpuser /var/www/html

# Remove unnecessary packages
RUN apt-get update && apt-get remove -y \
    telnet \
    ftp \
    netcat \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Hardening: disable xmlrpc, block directory listing, hide version
RUN { \
        echo '<Files xmlrpc.php>'; \
        echo '    Require all denied'; \
        echo '</Files>'; \
        echo 'Options -Indexes'; \
        echo 'ServerSignature Off'; \
        echo 'ServerTokens Prod'; \
        echo 'Header unset X-Powered-By'; \
    } > /etc/apache2/conf-available/security-hardening.conf && \
    a2enconf security-hardening && \
    a2enmod headers

# Configure Apache to drop privileges to wpuser at runtime
RUN sed -i 's/APACHE_RUN_USER=www-data/APACHE_RUN_USER=wpuser/' /etc/apache2/envvars && \
    sed -i 's/APACHE_RUN_GROUP=www-data/APACHE_RUN_GROUP=wpuser/' /etc/apache2/envvars

# Ensure wpuser can write to Apache runtime directories
RUN chown -R wpuser:wpuser /var/run/apache2 /var/log/apache2

# No USER directive – container starts as root, then Apache drops to wpuser
EXPOSE 80
